			)
		)
		(uuid "240e4f23-71a6-48f4-a5c1-39b7530c7659")
	)
	(text "MT3608 has UVLO at 1.98V, regulation down to 2V\nThis will fully utilize 2xAA batteries.\n\nTarget 3.811V -> WS2812C-2020-V1 min VDD = 3.7V + 3%\n3% -> 2% for regulator 1% for resistors\n\nVout = 0.6V * (1 + R1/R2)\n(3.8V/0.6V - 1) = R1 / R2\n100k / 18.2k => 3.89V"
		(exclude_from_sim no)
		(at 72.39 148.336 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2e3b37a5-880b-420b-9914-6a6e802ee410")
	)
	(text "Always-on:\nPowers CPU during deep sleep mode"
		(exclude_from_sim no)
		(at 264.414 41.91 0)
		(effects
