	)
	(text "Power states:\n\nFull on: 0.85V, 1.8V, 3.9V, 2.85V on - 40mA + LED (15mA) <- 5 mins to WFI sleep. 50 interactions -> 4.2 hours -> 200-500mAh\n\nWFI sleep: 0.85V, 1.8V, 3.9V, 2.85V on - 13mA + LED (5mA) <- 2 hours to deep sleep -> 10 hours/day -> 40 hours -> 720mAh\n\nDeep sleep: 3.9V, 2.85V on - 1mA no LED <- rest of time -> 60 hours -> 60 mAh\n\nConference is 100 hours long\nBattery is ~1800mAh\nAbove budget is 980mAh - 1500mAh total"
		(exclude_from_sim no)
		(at 18.796 171.958 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e019db83-a257-47a8-8e40-af3f0113be20")
	)
